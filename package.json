{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 5200",
    "prebuild": "npm run tokens:check",
    "build": "next build",
    "start": "next start --port 5200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "tokens:css": "tsx scripts/tokens-css.ts",
    "tokens:check": "tsx scripts/tokens-css.ts --check",
    "audit": "node scripts/audit-check.mjs",
    "proofs": "vitest run --project node -t @proof",
    "worker": "node --import tsx src/worker/main.ts",
    "worker:build": "tsup",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "bash scripts/db-deploy.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.49",
    "@clerk/nextjs": "6.39.6",
    "@prisma/client": "6.19.2",
    "@relay/claude-code-bridge": "*",
    "@tanstack/react-query": "5.102.8",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "ai": "7.0.93",
    "clsx": "2.1.1",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "superjson": "2.2.6",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.25",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "prisma": "6.19.2",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "workspaces": [
    "vendor/*"
  ]
}
