// Relay — Prisma schema.
//
// The Phase 1 half of the data model (master doc §25): who (Org, User,
// ConnectedAccount, OAuthState), record (Event, Job, AgentRun, AgentRunStep)
// and the two pointers (ProductFactsVersion, SideEffect). Campaign, people and
// draft entities land with slice 1.
//
// Conventions, applied without exception:
//   * cuid ids, `created_at` / `updated_at` on every table (Event excepted —
//     it is append-only and has nothing to update).
//   * snake_case table and column names via `@@map` / `@map`. The application
//     reads camelCase; SQL written by hand reads like SQL.
//   * `orgId` on every table but Org itself (§25, rule 3), and `ownerUserId`
//     on the rep-scoped ones.
//   * No `onDelete: Cascade` anywhere. Nothing is deleted (§25, rule 1), so a
//     cascade is a route that should not exist; `Restrict` is stated rather
//     than left to the default so the intent is on the page.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Who ─────────────────────────────────────────────────────────────────────

enum Role {
  rep
  admin

  @@map("role")
}

enum Provider {
  graph
  zoho
  linkedin
  lusha

  @@map("provider")
}

enum AccountStatus {
  healthy
  expiring
  revoked
  paused

  @@map("account_status")
}

/// A tenant. The only table with no `org_id`: it is the org.
model Org {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  connectedAccounts   ConnectedAccount[]
  oauthStates         OAuthState[]
  events              Event[]
  jobs                Job[]
  agentRuns           AgentRun[]
  agentRunSteps       AgentRunStep[]
  productFactsVersion ProductFactsVersion[]
  sideEffects         SideEffect[]
  campaigns           Campaign[]
  people              Person[]
  providerIdentities  ProviderIdentity[]
  campaignPeople      CampaignPerson[]
  contactSuppressions ContactSuppression[]
  creditLedger        CreditLedgerEntry[]
  outreachDrafts      OutreachDraft[]
  repVoices           RepVoice[]
  outreachEvents      OutreachEvent[]
  outreachSends       OutreachSend[]

  @@map("orgs")
}

/// A rep or an admin. `clerkId` is nullable because the local development
/// bypass (`DEV_USER_EMAIL`) signs in a user that Clerk has never seen.
/// Deactivation is a timestamp, not a delete (§25, rule 1).
model User {
  id             String    @id @default(cuid())
  orgId          String    @map("org_id")
  clerkId        String?   @unique @map("clerk_id")
  email          String
  name           String?
  role           Role      @default(rep)
  deactivatedAt  DateTime? @map("deactivated_at")
  /// How the rep's sent emails look (Relay P7): a font from the fixed list in
  /// `src/lib/outreach/emailHtml.ts`, a size in points, and the signature they
  /// pasted, stored already sanitised. Empty signature means none.
  emailFont      String    @default("Aptos") @map("email_font")
  emailFontSize  Int       @default(11) @map("email_font_size")
  emailSignature String    @default("") @map("email_signature")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  org               Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  connectedAccounts ConnectedAccount[]
  oauthStates       OAuthState[]
  events            Event[]
  jobs              Job[]
  campaigns         Campaign[]
  reviewedPeople    CampaignPerson[]   @relation("CampaignPersonReviewer")
  outreachDrafts    OutreachDraft[]    @relation("OutreachDraftOwner")
  decidedDrafts     OutreachDraft[]    @relation("OutreachDraftDecider")
  outreachEvents    OutreachEvent[]
  outreachSends     OutreachSend[]
  repVoice          RepVoice?

  @@unique([orgId, email])
  @@index([orgId])
  @@map("users")
}

/// One rep's connection to one provider. The send cap, window and ramp live
/// here rather than on the campaign: they are properties of the mailbox, and
/// two campaigns sharing a mailbox must share its limits (§25, "who").
///
/// `encTokens` holds the envelope produced by `src/lib/services/crypto.ts` —
/// never a plaintext token.
model ConnectedAccount {
  id           String        @id @default(cuid())
  orgId        String        @map("org_id")
  userId       String        @map("user_id")
  provider     Provider
  encTokens    String        @map("enc_tokens")
  scopes       String[]
  status       AccountStatus @default(healthy)
  connectedAt  DateTime      @default(now()) @map("connected_at")
  expiresAt    DateTime?     @map("expires_at")
  lastPolledAt DateTime?     @map("last_polled_at")
  /// Provider-side cursor (Graph delta link, Zoho modified-since). Scoped to
  /// this account so one rep's polling cannot move another's position.
  pollCursor   String?       @map("poll_cursor")
  dailyCap     Int           @default(10) @map("daily_cap")
  /// Local wall-clock, `HH:MM`. A string, not a time: the rep sets a window,
  /// not an instant, and a `time` column invites a timezone that is not there.
  windowStart  String        @default("09:00") @map("window_start")
  windowEnd    String        @default("16:30") @map("window_end")
  /// Weekdays sending is allowed, lower-case three-letter. Friday is out by
  /// default; the rep can put it back.
  days         String[]      @default(["mon", "tue", "wed", "thu"])
  rampStart    Int           @default(5) @map("ramp_start")
  pausedReason String?       @map("paused_reason")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, provider])
  @@index([orgId, provider])
  @@index([status, expiresAt])
  @@map("connected_accounts")
}

/// The OAuth `state` nonce, in the database rather than in a cookie or in
/// memory: the callback can land on a different instance than the one that
/// started the flow (master doc §24, "DB-backed OAuth state").
model OAuthState {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  provider  Provider
  state     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orgId, userId])
  @@index([expiresAt])
  @@map("oauth_states")
}

// ── Record ──────────────────────────────────────────────────────────────────

enum ActorKind {
  user
  system

  @@map("actor_kind")
}

/// Append-only. Every state change commits with its Event in one transaction
/// (§25, rule 4), which `src/lib/repo/mutate.ts` is the only place that does.
///
/// No `updated_at`: an Event that can be edited is not a record of anything.
/// `created_at` is when the row was written; `at` is when the thing happened,
/// which a backfill or a provider timestamp can put earlier.
///
/// `campaignId` and `personId` are plain columns, not relations: those tables
/// arrive with slice 1. They are indexed now so the timeline query the record
/// screen needs does not wait for a migration later.
model Event {
  id          String    @id @default(cuid())
  orgId       String    @map("org_id")
  actorKind   ActorKind @map("actor_kind")
  actorUserId String?   @map("actor_user_id")
  kind        String
  campaignId  String?   @map("campaign_id")
  personId    String?   @map("person_id")
  before      Json?
  after       Json?
  at          DateTime  @default(now())
  createdAt   DateTime  @default(now()) @map("created_at")

  org       Org   @relation(fields: [orgId], references: [id], onDelete: Restrict)
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orgId, at])
  @@index([kind, at])
  @@index([campaignId, at])
  @@index([personId, at])
  @@map("events")
}

// ── Campaign ────────────────────────────────────────────────────────────────

/// One rep's campaign: the brief research is asked to read around, and the
/// version of it that is current.
///
/// No `state` column, on purpose. Where a campaign is depends on research,
/// which finishes on the worker whenever it finishes, and a stored state is
/// stale the moment it does. The rep-facing state is derived from this row,
/// its latest research `Job` at `briefVersion`, and that job's
/// `research.completed` Event (`src/lib/campaigns/derive.ts`).
///
/// `brief` is research's own brief (`researchBriefSchema`): ISO region, the
/// rep's `who` verbatim, and only the scope the rep supplied. Earlier versions
/// are not lost when it changes: each version's brief is on its research job's
/// input and on the campaign's Events.
///
/// `startRequestId` is minted by the Start form. Unique per org, it is what
/// turns a double-pressed Start into one campaign rather than two.
///
/// The id is a cuid like every other table's. The `campaign.created` Event
/// takes it from the row `apply` wrote (`mutate`'s `campaignId` can be read
/// off `apply`'s result), so nothing has to be minted ahead of the row.
model Campaign {
  id                       String    @id @default(cuid())
  orgId                    String    @map("org_id")
  ownerUserId              String    @map("owner_user_id")
  name                     String
  briefVersion             Int       @default(1) @map("brief_version")
  brief                    Json
  startRequestId           String    @map("start_request_id")
  /// Set on a campaign made from one play of another campaign's research
  /// (Relay P1): that campaign, and the brief version whose research this one
  /// reads at its own version 1. Both or neither (a CHECK in the migration);
  /// the repo checks the source is this org's and this rep's.
  researchFromCampaignId   String?   @map("research_from_campaign_id")
  researchFromBriefVersion Int?      @map("research_from_brief_version")
  /// The play (an m16 candidate id) this campaign is for, once the rep chose
  /// plays on Plan ready. Confirm names it; null is research's own choice.
  playId                   String?   @map("play_id")
  /// When the rep paused this campaign's outreach (Relay P3); null while it
  /// runs. While paused nothing is due and nothing is sent.
  outreachPausedAt         DateTime? @map("outreach_paused_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  org            Org                 @relation(fields: [orgId], references: [id], onDelete: Restrict)
  ownerUser      User                @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  researchFrom   Campaign?           @relation("CampaignResearchFrom", fields: [researchFromCampaignId], references: [id], onDelete: Restrict)
  researchFor    Campaign[]          @relation("CampaignResearchFrom")
  jobs           Job[]
  people         CampaignPerson[]
  credits        CreditLedgerEntry[]
  drafts         OutreachDraft[]
  outreachEvents OutreachEvent[]
  outreachSends  OutreachSend[]

  @@unique([orgId, startRequestId])
  @@index([orgId, ownerUserId, createdAt])
  @@map("campaigns")
}

enum JobStatus {
  queued
  running
  done
  failed
  cancelled

  @@map("job_status")
}

/// The runtime spine and the outbox for every external write (§24, §25 rule 2).
///
/// A worker claims a row by moving it to `running` and setting `leaseUntil`; a
/// reaper returns rows whose lease has passed. `idempotencyKey` is unique per
/// org (`@@unique([orgId, idempotencyKey])`, below), so an enqueue that is
/// retried collides rather than duplicating the side effect, while two orgs
/// are free to use the same key for their own work. `responseDigest` records what the provider
/// said, so a replay can tell "already done" from "never happened".
model Job {
  id             String    @id @default(cuid())
  orgId          String    @map("org_id")
  /// Set when the job belongs to one rep's work; null for org-level jobs.
  ownerUserId    String?   @map("owner_user_id")
  kind           String
  idempotencyKey String    @map("idempotency_key")
  status         JobStatus @default(queued)
  priority       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  nextAt         DateTime  @default(now()) @map("next_at")
  leaseUntil     DateTime? @map("lease_until")
  workerId       String?   @map("worker_id")
  input          Json
  responseDigest String?   @map("response_digest")
  error          String?
  /// The campaign and brief version this job is research for. Both or neither
  /// (a CHECK in the migration); `enqueue` checks the campaign is this org's.
  campaignId     String?   @map("campaign_id")
  briefVersion   Int?      @map("brief_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  org         Org                 @relation(fields: [orgId], references: [id], onDelete: Restrict)
  ownerUser   User?               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  campaign    Campaign?           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  agentRuns   AgentRun[]
  sideEffects SideEffect[]
  people      CampaignPerson[]
  credits     CreditLedgerEntry[]
  drafts      OutreachDraft[]

  /// Scoped to the org, not global. An idempotency key is derived from what
  /// the job is about ("send touch 1 to this person"), so two tenants can
  /// legitimately produce the same string — and a global unique would answer
  /// the second one by silently dropping its work.
  @@unique([orgId, idempotencyKey])
  /// The claim query: the oldest due, highest-priority queued row.
  @@index([status, nextAt, priority])
  /// The reaper's query: expired leases.
  @@index([leaseUntil])
  @@index([orgId, createdAt])
  /// A campaign's latest research job at its current brief version.
  @@index([orgId, campaignId, briefVersion, createdAt])
  @@map("jobs")
}

enum AgentRunStatus {
  running
  done
  failed

  @@map("agent_run_status")
}

/// One agent loop, start to finish. "Every agent run is a first-class record:
/// inputs, steps, tool calls, outputs, cost" (§24, design law).
model AgentRun {
  id         String         @id @default(cuid())
  orgId      String         @map("org_id")
  jobId      String         @map("job_id")
  kind       String
  model      String
  status     AgentRunStatus @default(running)
  startedAt  DateTime       @default(now()) @map("started_at")
  finishedAt DateTime?      @map("finished_at")
  /// Sum of the steps' cost, in USD. Decimal, not Float: money that is added
  /// up thousands of times must not drift.
  costTotal  Decimal        @default(0) @map("cost_total") @db.Decimal(12, 6)
  error      String?
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  org   Org            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  job   Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  steps AgentRunStep[]

  @@index([orgId, startedAt])
  @@index([jobId])
  @@map("agent_runs")
}

enum AgentRunStepKind {
  model
  tool

  @@map("agent_run_step_kind")
}

/// One model call or one tool call inside a run, with what it cost.
///
/// `toolKey` is the tool-level idempotency key: unique within the org, so a
/// retried run that repeats a tool call collides instead of charging or
/// sending twice. Null for model steps, which have nothing external to repeat.
model AgentRunStep {
  id              String           @id @default(cuid())
  orgId           String           @map("org_id")
  runId           String           @map("run_id")
  index           Int
  kind            AgentRunStepKind
  name            String
  tokensIn        Int              @default(0) @map("tokens_in")
  tokensOut       Int              @default(0) @map("tokens_out")
  tokensCached    Int              @default(0) @map("tokens_cached")
  tokensReasoning Int              @default(0) @map("tokens_reasoning")
  cost            Decimal          @default(0) @db.Decimal(12, 6)
  toolKey         String?          @map("tool_key")
  input           Json?
  output          Json?
  /// Whatever the provider returned alongside the result — request id, stop
  /// reason, raw usage block. Kept so a cost figure can be argued with.
  providerMeta    Json?            @map("provider_meta")
  startedAt       DateTime         @default(now()) @map("started_at")
  finishedAt      DateTime?        @map("finished_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  org Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, index])
  /// Org-scoped for the same reason `Job.idempotencyKey` is.
  @@unique([orgId, toolKey])
  @@index([orgId, startedAt])
  @@map("agent_run_steps")
}

/// A pointer to the product facts an org has activated. The facts file itself
/// lives in the repository (§12); this records which version was in force, so
/// a draft can be read back against the facts it was written from.
model ProductFactsVersion {
  id          String   @id @default(cuid())
  orgId       String   @map("org_id")
  product     String
  version     Int
  /// Content hash of the facts file, so "version 3" can be proved to be the
  /// same version 3 the draft was written under.
  hash        String
  activatedAt DateTime @default(now()) @map("activated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Restrict)

  /// Scoped to the org, not global: two orgs each run their own version 1 of
  /// their own product, and rule 3 puts `org_id` on the row precisely so it can
  /// key things like this.
  @@unique([orgId, product, version])
  @@index([orgId, activatedAt])
  @@map("product_facts_versions")
}

/// Proof that a job's external effect happened exactly once. A job writes its
/// key here inside the same transaction as the effect's local record; a replay
/// of the same key collides on the unique index and stops.
model SideEffect {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  key       String
  jobId     String   @map("job_id")
  at        DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Restrict)
  job Job @relation(fields: [jobId], references: [id], onDelete: Restrict)

  /// Org-scoped for the same reason `Job.idempotencyKey` is.
  @@unique([orgId, key])
  @@index([orgId, at])
  @@index([jobId])
  @@map("side_effects")
}

// ── People and credits (lead gen v2.1 §6, §9) ────────────────────────────────

enum ProviderIdentityStatus {
  usable
  no_email
  invalid_id
  wrong_person
  /// The provider will not reveal this record (compliance): not bought again.
  restricted

  @@map("provider_identity_status")
}

/// What revealing a kept person's email came to (lead gen v2.1 §7, §9; v2.2 §9a).
enum CampaignPersonReveal {
  /// Bought now, and usable in this campaign.
  revealed
  /// Relay already owned a usable email: no credit.
  known
  /// No email exists, or the reveal returned none.
  no_email
  /// Opted out or do not contact: never contacted.
  suppressed
  /// An email or record Relay will not use in this campaign; `revealHold` says why.
  held
  /// The outcome is not known; its credit stays held and it is not bought again automatically.
  failed

  @@map("campaign_person_reveal")
}

enum CampaignPersonStatus {
  chosen
  spare

  @@map("campaign_person_status")
}

enum CampaignPersonSource {
  bought
  reused

  @@map("campaign_person_source")
}

/// The rep's decision on a chosen candidate before Reveal (lead gen v2.2 §9a). Pending is not kept.
enum CampaignPersonReview {
  pending
  kept
  dropped

  @@map("campaign_person_review")
}

/// Who a person is to the purchase, from the confirmed group's own roles (v2.2 §8a).
enum BuyerRolePart {
  runs
  champions
  signs

  @@map("buyer_role_part")
}

/// How a person's title matched that role (v2.2 §8a).
enum RoleMatchMethod {
  exact
  phrase

  @@map("role_match_method")
}

enum ContactSuppressionKind {
  email
  domain

  @@map("contact_suppression_kind")
}

enum ContactSuppressionReason {
  opted_out
  dnc

  @@map("contact_suppression_reason")
}

enum CreditKind {
  search
  reveal

  @@map("credit_kind")
}

enum CreditState {
  reserved
  reconciled
  unreconciled
  /// The request provably never left Relay (lead gen v2.2 note 2): it counts for nothing.
  released

  @@map("credit_state")
}

/// The org's canonical human/contact with a revealed email (lead gen v2.1 §9).
/// Whether that email is usable is decided per campaign, never stored here.
/// The email is kept lower case (a CHECK in the migration), so one address is
/// one Person.
model Person {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  email     String
  /// `work`, `personal` or `unknown`, as the reveal reported it.
  emailType String   @map("email_type")
  /// The provider's own grade word. Its vocabulary is unverified (v2.1 §7).
  grade     String?
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org                Org                @relation(fields: [orgId], references: [id], onDelete: Restrict)
  providerIdentities ProviderIdentity[]
  campaignPeople     CampaignPerson[]

  @@unique([orgId, email])
  @@map("people")
}

/// One provider record, org-scoped: which Person it is, or why it is unusable
/// (v2.1 §9). An unusable record stops Relay buying that record again and says
/// nothing about the human reached through another one.
model ProviderIdentity {
  id         String                 @id @default(cuid())
  orgId      String                 @map("org_id")
  provider   Provider
  providerId String                 @map("provider_id")
  personId   String?                @map("person_id")
  status     ProviderIdentityStatus @default(usable)
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  org    Org     @relation(fields: [orgId], references: [id], onDelete: Restrict)
  person Person? @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([orgId, provider, providerId])
  @@map("provider_identities")
}

/// A campaign's enrolment/candidate record (v2.1 §9). It starts from a
/// provider record; `personId` is set once the identity resolves to a Person.
/// One canonical human is never enrolled twice in one campaign's brief
/// version: a partial unique index in the migration.
///
/// `preview` is the provider's row as it came, raw domain included: the
/// registrable domain is only `companyKey`, for matching.
model CampaignPerson {
  id               String                @id @default(cuid())
  orgId            String                @map("org_id")
  campaignId       String                @map("campaign_id")
  briefVersion     Int                   @map("brief_version")
  /// The lead gen job that found this candidate.
  jobId            String                @map("job_id")
  provider         Provider
  providerId       String                @map("provider_id")
  personId         String?               @map("person_id")
  status           CampaignPersonStatus
  source           CampaignPersonSource
  rank             Int
  score            Int
  whyPicked        String                @map("why_picked")
  companyKey       String                @map("company_key")
  preview          Json
  /// The confirmed group's role this person plays, the role's own title, and
  /// how their title matched it (v2.2 §8a). All three or none: none is a
  /// Related role, or a run under a v2.1 handoff.
  rolePart         BuyerRolePart?        @map("role_part")
  roleTitle        String?               @map("role_title")
  roleMatch        RoleMatchMethod?      @map("role_match")
  /// The rep's keep or drop before Reveal (v2.2 §9a), with who and when once decided.
  review           CampaignPersonReview  @default(pending)
  reviewedByUserId String?               @map("reviewed_by_user_id")
  reviewedAt       DateTime?             @map("reviewed_at")
  /// What Reveal emails came to for this kept person, the hold reason word when
  /// it was not usable, and when. Null until revealed; only kept people are.
  reveal           CampaignPersonReveal? @map("reveal")
  revealHold       String?               @map("reveal_hold")
  revealedAt       DateTime?             @map("revealed_at")
  /// The day this person's sequence starts (Relay P3): a calendar day in
  /// Europe/London, set once by Start outreach. Each step's due day is worked
  /// out from it (`src/lib/outreach/sequence.ts`). Null until started.
  outreachStartOn  DateTime?             @map("outreach_start_on") @db.Date
  /// The rep's number for this person, for the calls (Relay P4); 40 characters at most.
  phone            String?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  org        Org             @relation(fields: [orgId], references: [id], onDelete: Restrict)
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  job        Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  person     Person?         @relation(fields: [personId], references: [id], onDelete: Restrict)
  drafts     OutreachDraft[]
  events     OutreachEvent[]
  sends      OutreachSend[]
  reviewedBy User?           @relation("CampaignPersonReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([orgId, campaignId, briefVersion, provider, providerId])
  @@index([orgId, campaignId, briefVersion, rank])
  @@map("campaign_people")
}

/// The only org-wide human/contact suppression (v2.1 §9): opt-out and
/// do-not-contact. Campaign-specific holds are never written here.
model ContactSuppression {
  id        String                   @id @default(cuid())
  orgId     String                   @map("org_id")
  kind      ContactSuppressionKind
  /// An email (lower case) or a registrable domain.
  value     String
  reason    ContactSuppressionReason
  /// Where it came from, e.g. `zoho` or `reply`.
  source    String
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  org Org @relation(fields: [orgId], references: [id], onDelete: Restrict)

  @@unique([orgId, kind, value])
  @@map("contact_suppressions")
}

/// One provider charge, reserved before the call at its documented worst
/// case and reconciled to what the provider reported (v2.1 §6). An unknown
/// outcome stays at its worst case. Written under a lock on the org row, so
/// two runs in one org cannot both spend the same credits.
model CreditLedgerEntry {
  id             String      @id @default(cuid())
  orgId          String      @map("org_id")
  campaignId     String      @map("campaign_id")
  briefVersion   Int         @map("brief_version")
  /// The Event whose cap this spend counts against: `campaign.confirmed` for a
  /// search, `campaign.reveal_confirmed` for a reveal. Each cap counts its own
  /// kind only; the balance counts every kind.
  confirmEventId String      @map("confirm_event_id")
  jobId          String      @map("job_id")
  kind           CreditKind
  /// The request's own key; a retry is a new key.
  key            String
  worstCase      Int         @map("worst_case")
  charged        Int?
  state          CreditState @default(reserved)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  org      Org      @relation(fields: [orgId], references: [id], onDelete: Restrict)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  job      Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([orgId, key])
  @@index([orgId, confirmEventId])
  @@index([orgId, createdAt])
  @@map("credit_ledger")
}

// ── Outreach (outreach v2 §3–§10, as amended by v2.1) ────────────────────────

/// Where a first email is (outreach v2.1): written and waiting for the rep,
/// parked because it failed the gates twice or could not be written, or
/// decided by the rep. Approved is Ready to send; nothing is sent in H1's
/// first slice.
enum OutreachDraftState {
  to_review
  needs_you
  failed
  approved
  rejected

  @@map("outreach_draft_state")
}

/// One draft of one touch for one kept, revealed person (outreach v2 §5).
/// The body is what sits between the greeting and the sign-off (v2.1 §4).
/// The lookup it rests on, the findings that parked it and the advice shown
/// beside it are kept with it, so the card can be argued with.
model OutreachDraft {
  id               String             @id @default(cuid())
  orgId            String             @map("org_id")
  campaignId       String             @map("campaign_id")
  briefVersion     Int                @map("brief_version")
  campaignPersonId String             @map("campaign_person_id")
  ownerUserId      String             @map("owner_user_id")
  /// The `outreach_draft` job that wrote it: one draft per touch per job.
  jobId            String             @map("job_id")
  touch            String
  /// 1 for the first draft; a rep's "wrong angle" or "wrong fact" asks for 2, and so on.
  attempt          Int                @default(1)
  state            OutreachDraftState
  subject          String?
  body             String?
  ask              String?
  opener           Json?
  claims           String[]           @default([])
  /// The Tier A findings that parked it, in rep words; empty when it passed.
  findings         Json
  /// Tier B advice shown on the card.
  advice           Json
  lookup           Json
  /// How many model generations it took: one, or two with the corrective redraft (v2.1 §6).
  generations      Int
  /// Model cost across its generations, in USD.
  costUsd          Decimal            @default(0) @map("cost_usd") @db.Decimal(12, 6)
  /// The rep's edited body, when they changed it before approving.
  editedBody       String?            @map("edited_body")
  /// How the edit changed it (§10): trim, reword, rewrite or factual.
  editClass        String?            @map("edit_class")
  rejectReason     String?            @map("reject_reason")
  decidedByUserId  String?            @map("decided_by_user_id")
  decidedAt        DateTime?          @map("decided_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  org            Org            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignPerson CampaignPerson @relation(fields: [campaignPersonId], references: [id], onDelete: Restrict)
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  owner          User           @relation("OutreachDraftOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  decidedBy      User?          @relation("OutreachDraftDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  /// One draft per job and touch: a sequence job writes seven, a redraft one.
  @@unique([orgId, jobId, touch])
  /// One draft per person, touch and attempt: a repeated press or a retried job
  /// cannot write a second first email for the same person.
  @@unique([orgId, campaignPersonId, touch, attempt], map: "outreach_drafts_one_per_attempt")
  @@index([orgId, ownerUserId, state])
  @@index([orgId, campaignId, briefVersion])
  @@map("outreach_drafts")
}

/// The rep's voice, v0 (master §15): up to eight pasted emails they are proud
/// of and a "how I write" note, given to the writer as examples, never as content.
model RepVoice {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  userId    String   @unique @map("user_id")
  /// The pasted emails, oldest first.
  samples   Json
  howIWrite String   @default("") @map("how_i_write")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org  Org  @relation(fields: [orgId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Written and read within the org, like every other row.
  @@unique([orgId, userId])
  @@map("rep_voices")
}

enum OutreachEventKind {
  sent
  accepted
  declined
  replied
  bounced
  done
  note
  meeting
  outcome
  undo

  @@map("outreach_event_kind")
}

enum OutreachOutcome {
  not_interested
  wrong_person
  bounced
  closed

  @@map("outreach_outcome")
}

enum CallResult {
  spoke
  voicemail
  no_answer
  wrong_number

  @@map("call_result")
}

/// What the rep recorded on a person's outreach (Relay P4): a step sent,
/// accepted, declined, replied, bounced or done, a note, a meeting, an outcome,
/// or an undo naming the row it reverses. Append-only, like `events`: no
/// `updated_at`, and a trigger in the migration refuses UPDATE and DELETE. The
/// fold (`src/lib/outreach/track.ts`) replays the rows in `seq` order.
model OutreachEvent {
  id               String            @id @default(cuid())
  orgId            String            @map("org_id")
  campaignId       String            @map("campaign_id")
  campaignPersonId String            @map("campaign_person_id")
  /// A step id from the sequence template, or null for a person-level row.
  step             String?
  kind             OutreachEventKind
  outcome          OutreachOutcome?
  callResult       CallResult?       @map("call_result")
  /// 2,000 characters at most (a CHECK in the migration).
  note             String?
  /// A calendar day in Europe/London.
  happenedOn       DateTime          @default(dbgenerated("((now() AT TIME ZONE 'Europe/London'::text))::date")) @map("happened_on") @db.Date
  undoesEventId    String?           @unique @map("undoes_event_id")
  byUserId         String            @map("by_user_id")
  /// Write order, taken at insert under the write path's lock on the person.
  seq              Int               @unique @default(autoincrement())
  createdAt        DateTime          @default(now()) @map("created_at")

  org            Org            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignPerson CampaignPerson @relation(fields: [campaignPersonId], references: [id], onDelete: Restrict)
  undoes         OutreachEvent? @relation("OutreachEventUndo", fields: [undoesEventId], references: [id], onDelete: Restrict)
  undoneBy       OutreachEvent? @relation("OutreachEventUndo")
  byUser         User           @relation(fields: [byUserId], references: [id], onDelete: Restrict)

  @@index([orgId, campaignPersonId, seq])
  @@index([orgId, campaignId])
  @@map("outreach_events")
}

enum OutreachSendState {
  sending
  sent
  unverified
  failed

  @@map("outreach_send_state")
}

/// One email step sent from the rep's mailbox (Relay P7). The row is written
/// BEFORE Microsoft is called, and its unique key is what makes a double
/// press send once: the second press finds the row and does not send. It
/// carries the mailbox's draft id as soon as there is one, so a send whose
/// outcome is unclear is checked by reading that message back, never by
/// sending again; and, once sent, the message and conversation ids Emails 2
/// and 3 reply to.
model OutreachSend {
  id                String            @id @default(cuid())
  orgId             String            @map("org_id")
  campaignId        String            @map("campaign_id")
  campaignPersonId  String            @map("campaign_person_id")
  /// An email step id from the sequence template.
  step              String
  byUserId          String            @map("by_user_id")
  state             OutreachSendState
  graphDraftId      String?           @map("graph_draft_id")
  messageId         String?           @map("message_id")
  internetMessageId String?           @map("internet_message_id")
  conversationId    String?           @map("conversation_id")
  /// When a press last claimed it: the day an unsettled send counts against the cap.
  claimedAt         DateTime          @default(now()) @map("claimed_at")
  /// Why the last attempt did not go, in a short code; null otherwise.
  failure           String?
  sentAt            DateTime?         @map("sent_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  org            Org            @relation(fields: [orgId], references: [id], onDelete: Restrict)
  campaign       Campaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  campaignPerson CampaignPerson @relation(fields: [campaignPersonId], references: [id], onDelete: Restrict)
  byUser         User           @relation(fields: [byUserId], references: [id], onDelete: Restrict)

  /// One send per person and step: the double-press guard.
  @@unique([orgId, campaignPersonId, step])
  @@index([orgId, byUserId, createdAt])
  @@map("outreach_sends")
}
