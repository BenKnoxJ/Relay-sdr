// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the shell in dark > renders campaigns as signed 1`] = `"<header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Campaigns</h1><p class="type-mono text-13 text-muted">none yet</p></header><section class="rounded-card border border-line bg-panel shadow-card p-0"><div class="px-5 py-14 text-center"><h2 class="type-heading mb-1.5">No campaigns yet</h2><p class="type-body mx-auto max-w-measure text-muted">Start one from Home.</p></div></section>"`;

exports[`the shell in dark > renders content as signed 1`] = `"<header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Content</h1><p class="type-mono text-13 text-muted">coming in the next release</p></header><section class="rounded-card border border-line bg-panel shadow-card p-0"><div class="px-5 py-14 text-center"><div class="mx-auto mb-3.5 grid h-14 w-14 place-items-center rounded-card bg-soft text-action"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false"><path d="M4 6h14M4 11h14M4 16h9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg></div><h2 class="type-heading mb-1.5">Posts drafted in your voice, on your calendar</h2><p class="type-body mx-auto max-w-measure text-muted">LinkedIn posts from what your campaigns learn, drafted for you to approve. Nothing posts until you say so. Arrives after this campaign finishes.</p></div></section>"`;

exports[`the shell in dark > renders home as signed 1`] = `"<header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Welcome, Ben</h1><p class="type-mono text-13 text-muted">Mon 7 Sep</p></header><div data-testid="home-grid" class="grid gap-grid"><div><section class="rounded-card border border-line bg-panel shadow-card mx-auto mt-8 max-w-[640px] p-8 pb-7 text-center"><h2 class="type-heading mb-1.5">Who do you want to reach, and why now?</h2><p class="type-body mb-4 text-muted">One sentence is enough. Relay asks for anything it still needs.</p><div class="mb-4"><p class="type-small text-muted">Connect your mailbox in Settings</p><p class="type-small text-muted">Ask your admin to connect Zoho</p></div><form action="javascript:throw new Error('A React form was unexpectedly submitted. If you called form.submit() manually, consider using form.requestSubmit() instead. If you\\'re trying to use event.stopPropagation() in a submit event handler, consider also calling event.preventDefault().')"><div data-testid="brief-pill" class="flex items-center gap-2.5 rounded-pill border-control border-line bg-ground py-1.5 pl-card-rail pr-1.5 text-left focus-within:ring-2"><label class="sr-only" for="_id_">Who do you want to reach, and why now?</label><textarea id="_id_" name="sentence" rows="2" required="" maxlength="2000" autocomplete="off" placeholder="UK logistics firms opening new depots this year, ops directors, offer call handling" class="type-body min-w-0 flex-1 resize-none bg-transparent py-1 text-ink outline-none placeholder:text-muted"></textarea><button type="submit" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action">Start</button></div><p role="status" class="sr-only"></p></form><p class="type-small mt-4 text-12 text-muted">Nothing is bought or sent until you confirm a plan.</p></section></div></div>"`;

exports[`the shell in dark > renders inbox as signed 1`] = `"<header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Inbox</h1><p class="type-mono text-13 text-muted">nothing waiting</p></header><section class="rounded-card border border-line bg-panel shadow-card p-0"><div class="px-5 py-14 text-center"><h2 class="type-heading mb-1.5">All clear</h2><p class="type-body mx-auto max-w-measure text-muted">Nothing waiting until your first campaign.</p></div></section>"`;

