exports[`Campaigns in dark > renders live-complete 1`] = `"<div><div data-testid="campaign-header" class="-mx-6 mb-grid border-b border-line bg-panel px-6 pb-3 pt-1 wide:sticky wide:top-0 wide:z-10"><div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><header class="flex items-baseline justify-between gap-3 mb-1.5"><h1 class="type-display">Practice owners at independent vets in</h1></header><ol aria-label="Where this campaign is" class="flex flex-wrap items-center gap-1.5"><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Brief</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Researching</li><li data-testid="state-step" aria-current="step" class="type-mono rounded-pill px-2 py-0.5 text-11 bg-action text-on-action">Plan ready</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Finding people</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Drafting</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Running</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Done</li></ol></div><div class="flex flex-col items-end gap-1.5"><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard cursor-not-allowed border-line bg-transparent text-muted hover:opacity-100 active:opacity-100 disabled:opacity-100" disabled="" aria-disabled="true">Confirm plan</button><p data-testid="action-note" class="type-small max-w-measure text-right text-muted">Finding people comes next. Confirming will start a search that uses credits, up to a limit you approve. Emails are only bought when you reveal them.</p></div></div><div class="mt-2"><div data-