exports[`Campaigns in light > renders page-running as signed 1`] = `"<div><div data-testid="campaign-header" class="-mx-6 mb-grid border-b border-line bg-panel px-6 pb-3 pt-1 wide:sticky wide:top-0 wide:z-10"><div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><header class="flex items-baseline justify-between gap-3 mb-1.5"><h1 class="type-display">UK logistics ops</h1></header><ol aria-label="Where this campaign is" class="flex flex-wrap items-center gap-1.5"><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Brief</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Researching</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Plan ready</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Finding people</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Drafting</li><li data-testid="state-step" aria-current="step" class="type-mono rounded-pill px-2 py-0.5 text-11 bg-action text-on-action">Running</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Done</li></ol></div><div class="flex flex-col items-end gap-1.5"><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-action bg-transparent text-action">Pause</button></div></div><div class="mt-2"></div></div><div class="grid grid-cols-[minmax(0,1fr)] items-start gap-grid wide:grid-cols-campaign"><div class="grid min-w-0 content-start gap-grid"><section class="rounded-card border border-line bg-panel p-card shadow-card"><h2 class="type-label mb-2.5">Progress</h2><dl class="grid grid-cols-5 gap-2"><div data-testid="progress-count" class="flex flex-col-reverse rounded-input border border-line px-3 py-2.5 text-center"><dt class="type-small text-muted">found</dt><dd class="type-mono-big">20</dd></div><div data-testid="progress-count" class="flex flex-col-reverse rounded-input border border-line px-3 py-2.5 text-center"><dt class="type-small text-muted">drafted</dt><dd class="type-mono-big">11</dd></div><div data-testid="progress-count" class="flex flex-col-reverse rounded-input border border-line px-3 py-2.5 text-center"><dt class="type-small text-muted">approved</dt><dd class="type-mono-big">9</dd></div><div data-testid="progress-count" class="flex flex-col-reverse rounded-input border border-line px-3 py-2.5 text-center"><dt class="type-small text-muted">sent</dt><dd class="type-mono-big">6</dd></div><div data-testid="progress-count" class="flex flex-col-reverse rounded-input border border-line px-3 py-2.5 text-center"><dt class="type-small text-muted">replied</dt><dd class="type-mono-big">2</dd></div></dl></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><button type="button" aria-expanded="false" data-testid="plan-toggle" class="flex w-full items-center justify-between gap-3 text-left focus-visible:outline-none focus-visible:ring-2"><span class="type-label">The plan, and the research behind it</span><span class="type-small text-muted">show</span></button></section></div><aside data-testid="support-rail" class="rounded-card border border-line bg-panel wide:sticky wide:top-[calc(var(--relay-header-h,0px)+16px)]"><div role="tablist" aria-label="Alongside this campaign" class="flex flex-wrap gap-1 border-b border-line px-3 pt-2"><button type="button" role="tab" data-testid="rail-tab-spend" aria-selected="false" tabindex="-1" class="-mb-px border-b-2 px-2 pb-2 pt-1 text-13 font-semibold transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-transparent text-muted hover:text-ink">Spend</button><button type="button" role="tab" data-testid="rail-tab-brief" aria-selected="true" tabindex="0" class="-mb-px border-b-2 px-2 pb-2 pt-1 text-13 font-semibold transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-action text-ink">Brief</button></div><div role="tabpanel" data-testid="rail-panel-brief" class="max-h-[calc(100vh-var(--relay-header-h,0px)-72px)] overflow-y-auto p-card"><div data-testid="brief-bare"><dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5"><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Product</dt><dd class="type-small">Insights360</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Motion</dt><dd class="type-small">Direct</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Who</dt><dd class="type-small">Ops directors at UK logistics firms opening depots</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Where</dt><dd class="type-small">United Kingdom</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">How many</dt><dd class="type-small">20 people over 3 weeks</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Channels</dt><dd class="type-small">Email, LinkedIn</dd></div></dl></div></div></aside></div></div>"`;

exports[`Campaigns in light > renders page-stopped as signed 1`] = `"<div><div data-testid="campaign-header" class="-mx-6 mb-grid border-b border-line bg-panel px-6 pb-3 pt-1 wide:sticky wide:top-0 wide:z-10"><div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><header class="flex items-baseline justify-between gap-3 mb-1.5"><h1 class="type-display">Vets, Scotland</h1></header><ol aria-label="Where this campaign is" class="flex flex-wrap items-center gap-1.5"><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Brief</li><li data-testid="state-step" aria-current="step" class="type-mono rounded-pill px-2 py-0.5 text-11 bg-warn-bg text-warn">Researching · stopped</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Plan ready</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Finding people</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Drafting</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Running</li><li data-testid="state-step" class="type-mono rounded-pill px-2 py-0.5 text-11 text-muted">Done</li></ol></div><div class="flex flex-col items-end gap-1.5"><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action">Widen the brief</button></div></div><div class="mt-2"></div></div><div class="grid grid-cols-[minmax(0,1fr)] items-start gap-grid wide:grid-cols-campaign"><div class="grid min-w-0 content-start gap-grid"><section class="rounded-card border border-line bg-panel p-card shadow-card max-w-[760px]"><p class="type-small mb-3 rounded-input bg-warn-bg px-3 py-2.5 text-warn">Not enough evidence to write a plan. Nothing has been spent.</p><p data-testid="stop-reason" class="type-body mb-4">Too few independent practices of this size in Scotland show any sign of the pain.</p><div class="grid gap-grid wide:grid-cols-2"><div><h3 class="type-label mb-1.5">What it did find</h3><div data-testid="pack-item" class="flex break-inside-avoid items-start gap-2.5 py-1.5"><span data-testid="confidence" class="type-mono inline-flex shrink-0 items-center rounded-pill px-2 py-0.5 text-11 bg-ground text-muted">weak</span><span class="type-small min-w-0 [overflow-wrap:anywhere]">Three independent practices with four to six sites, all three listing out of hours triage as a service.<span class="type-small block text-muted"><a href="https://vettimes.co.uk/a/found-triage" target="_blank" rel="noreferrer" class="underline focus-visible:outline-none focus-visible:ring-2">vettimes.co.uk</a> · 2 Jun 2026</span></span></div><div data-testid="pack-item" class="flex break-inside-avoid items-start gap-2.5 py-1.5"><span data-testid="confidence" class="type-mono inline-flex shrink-0 items-center rounded-pill px-2 py-0.5 text-11 bg-warn-bg text-warn">a guess</span><span class="type-small min-w-0 [overflow-wrap:anywhere]">No trade press and no hiring anywhere in the last twelve months for practices of this size.<span class="type-small block text-muted">No source. Relay inferred this from eleven searches that returned nothing datable</span></span></div></div><fieldset class="min-w-0"><legend class="type-label mb-1.5">What would help</legend><ul class="grid gap-chips"><li data-testid="widening" class="py-1.5"><span data-testid="widen-heading" class="type-small block font-semibold">Widen the region</span><span class="type-small block text-muted">Look at the whole of the United Kingdom rather than Scotland alone.</span></li><li data-testid="widening" class="py-1.5"><span data-testid="widen-heading" class="type-small block font-semibold">Widen the size</span><span class="type-small block text-muted">Look at every practice with three or more sites rather than four to six.</span></li><li data-testid="widening" class="py-1.5"><span data-testid="widen-heading" class="type-small block font-semibold">Widen the kind of organisation</span><span class="type-small block text-muted">Look at practice groups as well as independent practices.</span></li></ul><p data-testid="widen-note" class="type-small mt-2 text-muted">Choose one, and Relay looks again</p></fieldset></div></section></div><aside data-testid="support-rail" class="rounded-card border border-line bg-panel wide:sticky wide:top-[calc(var(--relay-header-h,0px)+16px)]"><div role="tablist" aria-label="Alongside this campaign" class="flex flex-wrap gap-1 border-b border-line px-3 pt-2"><button type="button" role="tab" data-testid="rail-tab-spend" aria-selected="false" tabindex="-1" class="-mb-px border-b-2 px-2 pb-2 pt-1 text-13 font-semibold transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-transparent text-muted hover:text-ink">Spend</button><button type="button" role="tab" data-testid="rail-tab-brief" aria-selected="true" tabindex="0" class="-mb-px border-b-2 px-2 pb-2 pt-1 text-13 font-semibold transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-action text-ink">Brief</button></div><div role="tabpanel" data-testid="rail-panel-brief" class="max-h-[calc(100vh-var(--relay-header-h,0px)-72px)] overflow-y-auto p-card"><div data-testid="brief-bare"><dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5"><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Product</dt><dd class="type-small">Insights360</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Motion</dt><dd class="type-small">Direct</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Who</dt><dd class="type-small">Practice owners at independent vets in Scotland</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Where</dt><dd class="type-small">United Kingdom</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">How many</dt><dd class="type-small">20 people over 3 weeks</dd></div><div data-testid="brief-field" class="contents"><dt class="type-small text-muted">Channels</dt><dd class="type-small">Email</dd></div></dl></div></div></aside></div></div>"`;

exports[`Campaigns in light > renders start as signed 1`] = `"<header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">New campaign</h1><p class="type-mono text-13 text-muted">step 2 of 2</p></header><section class="rounded-card border border-line bg-panel p-card shadow-card mx-auto max-w-[760px]"><p class="type-label mb-1">Who do you want to reach, and why now?</p><div class="mb-4 flex flex-wrap items-center gap-2 rounded-input border-control border-line bg-ground py-1.5 pl-4 pr-1.5 sm:rounded-pill"><input aria-label="Who do you want to reach, and why now?" class="type-small min-w-0 flex-1 basis-40 bg-transparent focus-visible:outline-none" value=""><button type="button" class="inline-flex items-center justify-center rounded-pill py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent text-muted shrink-0 whitespace-nowrap px-2.5">Read it</button></div><p class="type-small mb-3 text-muted">Here is what Relay understood. Fix anything, then start the research.</p><div class="grid gap-grid wide:grid-cols-2"><div data-testid="start-field"><p class="type-label mb-1">Product</p><select aria-label="Product" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line"><option value="Insights360">Insights360</option></select><p class="type-small mt-1 text-muted">Product facts not yet activated for this product. More products as the knowledge base grows.</p></div><div data-testid="start-field"><p class="type-label mb-1">Motion</p><div class="flex gap-chips rounded-input border-control border-dashed border-muted p-2"><button type="button" data-testid="motion-chip" aria-pressed="true" class="rounded-pill border px-3 py-1 text-13 transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-transparent bg-soft text-action">Direct</button><button type="button" data-testid="motion-chip" aria-pressed="false" class="rounded-pill border px-3 py-1 text-13 transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-line bg-panel text-muted">Channel</button></div><p class="type-small mt-1 text-muted">Not in your sentence, so these are the suggested defaults.</p></div><div data-testid="start-field"><p class="type-label mb-1">Region</p><select aria-label="Region" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-dashed border-muted"><option value="GB">United Kingdom</option><option value="IE">Ireland</option><option value="US">United States</option></select></div><div data-testid="start-field"><p class="type-label mb-1">How many, over how long</p><div class="flex gap-chips"><select aria-label="people" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-dashed border-muted"><option value="10">10 people</option><option value="20">20 people</option><option value="30">30 people</option><option value="50">50 people</option></select><select aria-label="weeks" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-dashed border-muted"><option value="2">2 weeks</option><option value="3">3 weeks</option><option value="4">4 weeks</option><option value="6">6 weeks</option></select></div><p class="type-small mt-1 text-muted">Not in your sentence, so these are the suggested defaults. Relay finds the strongest-fit accounts first, then the people who run, champion and sign off the problem at each. You review them all before any email is bought.</p></div><div data-testid="start-field" class="col-span-full"><p class="type-label mb-1">Channels</p><div class="flex gap-chips rounded-input border-control border-dashed border-muted p-2"><button type="button" data-testid="channel-chip" aria-pressed="true" disabled="" class="rounded-pill border px-3 py-1 text-13 transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-transparent bg-soft text-action">Email</button><button type="button" data-testid="channel-chip" aria-pressed="false" class="rounded-pill border px-3 py-1 text-13 transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-line bg-panel text-muted">LinkedIn</button><button type="button" data-testid="channel-chip" aria-pressed="false" class="rounded-pill border px-3 py-1 text-13 transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-line bg-panel text-muted">Calls</button></div><p class="type-small mt-1 text-muted">Email is always on. Tick Calls only if you will phone: Relay adds a call for each person once the emails are written.</p></div><div data-testid="start-field" class="col-span-full"><p class="type-label mb-1">Do you already have customers like this? Who, and what did they buy it for?</p><textarea aria-label="Do you already have customers like this? Who, and what did they buy it for?" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line"></textarea><p class="type-small mt-1 text-muted">Optional. Relay looks for more like them and never names them.</p></div></div><div data-testid="hard-limits" class="mt-5 border-t border-line pt-4"><button type="button" aria-expanded="false" aria-controls="hard-limits-fields" class="flex min-h-6 w-full items-center justify-between gap-3 rounded-input text-left focus-visible:outline-none focus-visible:ring-2"><span class="type-label">Add hard limits (optional)</span><span class="text-13 font-semibold text-action">Show</span></button><p data-testid="limits-summary" class="type-small mt-1 text-muted">No hard limits. Research can explore within your brief.</p><div id="hard-limits-fields" hidden=""><p class="type-small mb-3 mt-1 text-muted">Only use these for boundaries Relay must not cross. Research will work out the kinds of organisation, company sizes and roles worth targeting.</p><div class="grid gap-grid wide:grid-cols-2"><div data-testid="start-field"><p class="type-label mb-1">Also search in</p><div class="flex flex-wrap gap-chips"><button type="button" data-testid="country-chip" aria-pressed="false" class="rounded-pill border px-3 py-1 text-13 transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-line bg-panel text-muted">Ireland</button><button type="button" data-testid="country-chip" aria-pressed="false" class="rounded-pill border px-3 py-1 text-13 transition-colors duration-micro ease-standard focus-visible:outline-none focus-visible:ring-2 border-line bg-panel text-muted">United States</button></div></div><div data-testid="start-field"><p class="type-label mb-1">Only this size</p><div class="flex gap-chips"><input aria-label="From" inputmode="numeric" placeholder="From" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line min-w-0 flex-1" value=""><input aria-label="To" inputmode="numeric" placeholder="To" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line min-w-0 flex-1" value=""><select aria-label="Counted in" class="type-small rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line w-auto shrink-0"><option value="employees">people employed</option><option value="seats">seats</option><option value="sites">sites</option></select></div></div><div data-testid="start-field" class="col-span-full"><p class="type-label mb-1">Only these places</p><div><div class="grid gap-chips wide:grid-cols-[1fr_1fr_auto]"><input aria-label="Only these places" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line" value=""><input aria-label="Also called" placeholder="Other names, separated by commas" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line" value=""><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-action bg-transparent text-action">Add</button></div></div></div><div data-testid="start-field" class="col-span-full"><p class="type-label mb-1">Only these kinds of organisation</p><div><div class="flex gap-chips"><input aria-label="Only these kinds of organisation" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line" value=""><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-action bg-transparent text-action">Add</button></div></div></div><div data-testid="start-field"><p class="type-label mb-1">Only these roles</p><div><div class="flex gap-chips"><input aria-label="Only these roles" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line" value=""><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-action bg-transparent text-action">Add</button></div></div></div><div data-testid="start-field"><p class="type-label mb-1">Never these roles</p><div><div class="flex gap-chips"><input aria-label="Never these roles" class="type-small w-full rounded-input border-control bg-panel px-3 py-2 focus-visible:outline-none focus-visible:ring-2 border-line" value=""><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-action bg-transparent text-action">Add</button></div></div></div></div></div></div><div class="mt-5 flex flex-wrap items-center gap-3 border-t border-line pt-4"><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action" disabled="">Start research</button><span data-testid="start-blocked" class="type-small text-muted">Start is off until the sentence is read.</span></div></section>"`;
