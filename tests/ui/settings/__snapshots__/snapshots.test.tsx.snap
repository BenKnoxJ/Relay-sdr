// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Settings in dark > renders 5-settings as signed 1`] = `
"<div><header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Settings</h1><p class="type-mono text-13 text-muted">yours, not the org's</p></header><div class="grid max-w-[720px] gap-grid"><section class="rounded-card border border-line bg-panel p-card shadow-card"><h2 class="type-label mb-2.5">Mailbox</h2><div class="grid justify-items-start gap-3"><p class="type-body text-muted">Relay sends from your own mailbox. Connect it to start.</p><form action="javascript:throw new Error('A React form was unexpectedly submitted. If you called form.submit() manually, consider using form.requestSubmit() instead. If you\\'re trying to use event.stopPropagation() in a submit event handler, consider also calling event.preventDefault().')"><button type="submit" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action">Connect your mailbox</button></form></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">LinkedIn</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><div class="grid gap-2"><div class="flex items-center gap-2.5"><label for="_id_" class="type-small w-[136px] shrink-0 text-muted">Your profile</label><input id="_id_" inputmode="url" autocomplete="url" spellcheck="false" placeholder="https://www.linkedin.com/in/your-name" class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2" type="url" value="https://www.linkedin.com/in/benknoxjohnston"></div><p class="type-small text-muted">Relay prepares LinkedIn messages for you to paste. Posting from Relay arrives with Content.</p></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">Your voice</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span>7 emails</span><span role="status" class="sr-only"></span></span></div><ul id="_id_-list" class="mb-1 divide-y divide-line"><li data-testid="voice-sample" class="flex items-baseline justify-between gap-3 py-2"><div class="min-w-0"><p class="type-body truncate text-ink">Re: Depot phones after the Leeds opening</p><p class="type-small text-muted">93 words · added 14 Aug</p></div><button type="button" class="inline-flex items-center justify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: Re: Depot phones after the Leeds opening">Remove</button></li><li data-testid="voice-sample" class="flex items-baseline justify-between gap-3 py-2"><div class="min-w-0"><p class="type-body truncate text-ink">Quick one on the night line</p><p class="type-small text-muted">51 words · added 20 Aug</p></div><button type="button" class="inline-flex items-center justify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: Quick one on the night line">Remove</button></li><li data-testid="voice-sample" class="flex items-baseline justify-between gap-3 py-2"><div class="min-w-0"><p class="type-body truncate text-ink">Following up from Tuesday</p><p class="type-small text-muted">75 words · added 26 Aug</p></div><button type="button" class="inline-flex items-center justify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: Following up from Tuesday">Remove</button></li></ul><div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 pb-3 pt-1"><button type="button" aria-expanded="false" aria-controls="_id_-list" class="type-small rounded-pill text-muted focus-visible:outline-none focus-visible:ring-2">Show 4 more</button><button type="button" aria-expanded="false" aria-controls="_id_-add" class="type-small rounded-pill font-semibold text-action focus-visible:outline-none focus-visible:ring-2">Add an email you are proud of</button></div><div class="grid gap-1.5"><div class="flex items-baseline justify-between gap-3"><label for="_id_-note" class="type-label">How I write</label><span class="type-small text-muted">Ten lines at most.</span></div><textarea id="_id_-note" rows="5" placeholder="Short. One question per email. British spelling. I sign off with my first name." class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2">Short. One question per email.
I never say "reach out" or "circle back".
First names from the first line.
British spelling.
I sign off "Ben", no title.</textarea><p class="type-small text-muted">Used as examples in every draft. Never sent, never shared.</p></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">Calls</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><div class="flex items-center justify-between gap-3"><span id="_id_" class="type-body text-ink">Include a day-3 call in new campaigns by default</span><button type="button" role="switch" aria-checked="true" aria-labelledby="_id_" class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-pill border-control transition-opacity duration-micro ease-standard hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 border-transparent bg-action"><span aria-hidden="true" class="absolute h-4 w-4 rounded-pill transition-transform duration-micro ease-standard translate-x-6 bg-on-action"></span><span class="sr-only">On</span></button></div><p class="type-small mt-1.5 text-muted">You can still turn Calls off per campaign at Start.</p></section></div></div>"
`;

