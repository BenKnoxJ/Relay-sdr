exports[`Settings in dark > renders 5-settings as signed 1`] = `"<div><header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Settings</h1><p class="type-mono text-13 text-muted">yours, not the org's</p></header><div class="grid max-w-[720px] gap-grid"><section class="rounded-card border border-line bg-panel p-card shadow-card"><h2 class="type-label mb-2.5">Mailbox</h2><div class="grid justify-items-start gap-3"><p class="type-body text-muted">Relay sends from your own mailbox. Connect it to start.</p><form action="javascript:throw new Error('A React form was unexpectedly submitted. If you called form.submit() manually, consider using form.requestSubmit() instead. If you\\'re trying to use event.stopPropagation() in a submit event handler, consider also calling event.preventDefault().')"><button type="submit" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action">Connect your mailbox</button></form></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">LinkedIn</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><div class="grid gap-2"><div class="flex flex-wrap items-center gap-2.5"><label for="_id_" class="type-small w-[136px] shrink-0 text-muted">Your profile</label><input id="_id_" inputmode="url" autocomplete="url" spellcheck="false" placeholder="https://www.linkedin.com/in/…" class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2 min-w-0 flex-1 basis-40" type="url" value=""></div><p class="type-small text-muted">Relay prepares LinkedIn messages for you to paste. Posting from Relay arrives with Content.</p></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">Your voice</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><p class="type-body mb-3 max-w-measure text-muted">Paste 5 to 10 emails you are proud of. Relay uses them as examples in every draft and never sends them.</p><div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 pb-3 pt-1"><button type="button" disabled="" aria-expanded="false" aria-controls="_id_-add" class="type-small rounded-pill font-semibold text-action focus-visible:outline-none focus-visible:ring-2 disabled:opacity-50">Add an email you are proud of</button><span data-testid="voice-add-coming" class="type-small text-muted">Saving your voice arrives with outreach.</span></div><div class="grid gap-1.5"><div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1"><label for="_id_-note" class="type-label">How I write</label><span class="type-small text-muted">Ten lines at most.</span></div><textarea id="_id_-note" rows="5" placeholder="Short. One question per email. British spelling. I sign off with my first name." class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2"></textarea><p class="type-small text-muted">Used as examples in every draft. Never sent, never shared.</p></div></section></div></div>"`;

