exports[`Settings in dark > renders 5-settings as signed 1`] = `"<div><header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Settings</h1><p class="type-mono text-13 text-muted">yours, not the org's</p></header><div class="grid max-w-[720px] gap-grid"><section class="rounded-card border border-line bg-panel p-card shadow-card"><h2 class="type-label mb-2.5">Mailbox</h2><div class="grid justify-items-start gap-3"><p class="type-body text-muted">Relay sends from your own mailbox. Connect it to start.</p><form action="javascript:throw new Error('A React form was unexpectedly submitted. If you called form.submit() manually, consider using form.requestSubmit() instead. If you\\'re trying to use event.stopPropagation() in a submit event handler, consider also calling event.preventDefault().')"><button type="submit" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action">Connect your mailbox</button></form></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">Your email look</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><div data-testid="email-look" class="grid gap-4"><p class="type-small text-muted">Relay sends your emails from Outlook in this font, with this signature. Paste your signature as it appears in Outlook.</p><div class="flex flex-wrap gap-3"><label for="_id_" class="grid gap-1"><span class="type-label">Font</span><select id="_id_" data-testid="email-look-font" class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2 w-56"><option value="Aptos">Aptos</option><option value="Calibri">Calibri</option><option value="Arial">Arial</option><option value="Segoe UI">Segoe UI</option><option value="Verdana">Verdana</option><option value="Tahoma">Tahoma</option><option value="Georgia">Georgia</option><option value="Times New Roman">Times New Roman</option></select></label><label for="_id_" class="grid gap-1"><span class="type-label">Size</span><select id="_id_" data-testid="email-look-size" class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2 w-24"><option value="8">8 pt</option><option value="9">9 pt</option><option value="10">10 pt</option><option value="11">11 pt</option><option value="12">12 pt</option><option value="13">13 pt</option><option value="14">14 pt</option><option value="15">15 pt</option><option value="16">16 pt</option><option value="17">17 pt</option><option value="18">18 pt</option><option value="19">19 pt</option><option value="20">20 pt</option></select></label></div><div class="grid gap-1"><span id="_id_" class="type-label">Signature</span><div role="textbox" aria-multiline="true" aria-labelledby="_id_" aria-placeholder="Paste your Outlook signature here" contenteditable="true" data-testid="email-look-signature" class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2 min-h-24 bg-panel empty:before:text-muted empty:before:content-[attr(aria-placeholder)]"></div><div class="flex flex-wrap gap-2 pt-1"><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action" data-testid="email-look-save">Save</button><button type="button" class="inline-flex items-center justify-center rounded-pill py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted" data-testid="email-look-clear">Clear signature</button></div></div><div class="grid gap-1"><span class="type-label">Preview</span><p class="type-small text-muted">A sample email as your prospects will see it.</p><iframe title="Preview" data-testid="email-look-preview" sandbox="" srcdoc="<!doctype html><html><head><meta charset=&quot;utf-8&quot;><meta name=&quot;color-scheme&quot; content=&quot;light&quot;></head><body style=&quot;margin:16px;background:#ffffff;color:#000000&quot;></body></html>" class="h-72 w-full rounded-input border border-line bg-panel"></iframe></div></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">LinkedIn</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><div class="grid gap-2"><div class="flex flex-wrap items-center gap-2.5"><label for="_id_" class="type-small w-[136px] shrink-0 text-muted">Your profile</label><input id="_id_" inputmode="url" autocomplete="url" spellcheck="false" placeholder="https://www.linkedin.com/in/…" class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2 min-w-0 flex-1 basis-40" type="url" value=""></div><p class="type-small text-muted">Relay prepares LinkedIn messages for you to paste. Posting from Relay arrives with Content.</p></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">Your voice</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><p class="type-body mb-3 max-w-measure text-muted">Paste 5 to 10 emails you are proud of. Relay uses them as examples in every draft and never sends them.</p><div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 pb-3 pt-1"><button type="button" aria-expanded="false" aria-controls="_id_-add" class="type-small rounded-pill font-semibold text-action focus-visible:outline-none focus-visible:ring-2">Add an email you are proud of</button></div><div class="grid gap-1.5"><div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1"><label for="_id_-note" class="type-label">How I write</label><span class="type-small text-muted">Ten lines at most.</span></div><textarea id="_id_-note" rows="5" placeholder="Short. One question per email. British spelling. I sign off with my first name." class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2"></textarea><p class="type-small text-muted">Used as examples in every draft. Never sent, never shared.</p></div></section></div></div>"`;

