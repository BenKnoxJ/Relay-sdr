ify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: Following up from Tuesday">Remove</button></li><li data-testid="voice-sample" class="flex items-baseline justify-between gap-3 py-2"><div class="min-w-0"><p class="type-body truncate text-ink">Re: Sunday service and the phones</p><p class="type-small text-muted">47 words · added 28 Aug</p></div><button type="button" class="inline-flex items-center justify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: Re: Sunday service and the phones">Remove</button></li><li data-testid="voice-sample" class="flex items-baseline justify-between gap-3 py-2"><div class="min-w-0"><p class="type-body truncate text-ink">Re: not the right time</p><p class="type-small text-muted">43 words · added 1 Sep</p></div><button type="button" class="inline-flex items-center justify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: Re: not the right time">Remove</button></li><li data-testid="voice-sample" class="flex items-baseline justify-between gap-3 py-2"><div class="min-w-0"><p class="type-body truncate text-ink">Your second depot</p><p class="type-small text-muted">48 words · added 3 Sep</p></div><button type="button" class="inline-flex items-center justify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: Your second depot">Remove</button></li><li data-testid="voice-sample" class="flex items-baseline justify-between gap-3 py-2"><div class="min-w-0"><p class="type-body truncate text-ink">After the call this morning</p><p class="type-small text-muted">46 words · added 5 Sep</p></div><button type="button" class="inline-flex items-center justify-center rounded-pill text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted py-0" aria-label="Remove: After the call this morning">Remove</button></li></ul><div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 pb-3 pt-1"><button type="button" aria-expanded="true" aria-controls="_id_-list" class="type-small rounded-pill text-muted focus-visible:outline-none focus-visible:ring-2">Show fewer</button></div><div id="_id_-add" class="mb-4 grid gap-2"><label for="_id_-add-text" class="type-small text-muted">The email, pasted in full</label><textarea id="_id_-add-text" rows="6" placeholder="Paste the whole email, subject line first." class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2"></textarea><div class="flex items-center gap-3"><button type="button" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action">Add</button><button type="button" class="inline-flex items-center justify-center rounded-pill py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-0 bg-transparent px-0 text-muted">Cancel</button></div></div><div class="grid gap-1.5"><div class="flex items-baseline justify-between gap-3"><label for="_id_-note" class="type-label">How I write</label><span class="type-small text-muted">Ten lines at most.</span></div><textarea id="_id_-note" rows="5" placeholder="Short. One question per email. British spelling. I sign off with my first name." class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visible:ring-2">Short. One question per email.
I never say "reach out" or "circle back".
First names from the first line.
British spelling.
I sign off "Ben", no title.</textarea><p class="type-small text-muted">Used as examples in every draft. Never sent, never shared.</p></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">Calls</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><div class="flex items-center justify-between gap-3"><span id="_id_" class="type-body text-ink">Include a day-3 call in new campaigns by default</span><button type="button" role="switch" aria-checked="true" aria-labelledby="_id_" class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-pill border-control transition-opacity duration-micro ease-standard hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 border-transparent bg-action"><span aria-hidden="true" class="absolute h-4 w-4 rounded-pill transition-transform duration-micro ease-standard translate-x-6 bg-on-action"></span><span class="sr-only">On</span></button></div><p class="type-small mt-1.5 text-muted">You can still turn Calls off per campaign at Start.</p></section></div></div>"
`;
