exports[`Settings in light > renders 5-voice-open as signed 1`] = `"<div><header class="mb-grid flex items-baseline justify-between gap-3"><h1 class="type-display">Settings</h1><p class="type-mono text-13 text-muted">yours, not the org's</p></header><div class="grid max-w-[720px] gap-grid"><section class="rounded-card border border-line bg-panel p-card shadow-card"><h2 class="type-label mb-2.5">Mailbox</h2><div class="grid justify-items-start gap-3"><p class="type-body text-muted">Relay sends from your own mailbox. Connect it to start.</p><form action="javascript:throw new Error('A React form was unexpectedly submitted. If you called form.submit() manually, consider using form.requestSubmit() instead. If you\\'re trying to use event.stopPropagation() in a submit event handler, consider also calling event.preventDefault().')"><button type="submit" class="inline-flex items-center justify-center rounded-pill border-control px-4 py-2 text-13 font-semibold focus-visible:outline-none focus-visible:ring-2 transition-opacity duration-micro ease-standard hover:opacity-90 active:opacity-80 disabled:opacity-50 border-transparent bg-action text-on-action">Connect your mailbox</button></form></div></section><section class="rounded-card border border-line bg-panel p-card shadow-card"><div class="mb-2.5 flex items-center justify-between gap-3"><h2 class="type-label">Your email look</h2><span class="type-mono max-w-measure text-right text-11 font-medium text-muted"><span role="status" class=""></span></span></div><div data-testid="email-look" class="grid gap-4"><p class="type-small text-muted">Relay sends your emails from Outlook in this font, with this signature. Paste your signature as it appears in Outlook.</p><div class="flex flex-wrap gap-3"><label for="_id_" class="grid gap-1"><span class="type-label">Font</span><select id="_id_" data-testid="email-look-font" class="type-body w-full rounded-input border-control border-line bg-ground px-3 py-2 text-ink outline-none focus-visib